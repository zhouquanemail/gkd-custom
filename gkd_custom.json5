// ZCode 局部补丁 v14
// 变更:
//  v13: group 30 action → clickCenter（真实触摸；替换流程误操作导致装机未生）
//  v14: group 30 action → back（Activity 级返回，system 直接销毁 VungleActivity，零依赖 HTML 按钮响应）
{
  id: 10010001,
  name: 'ZCode 局部补丁',
  version: 14,
  author: 'zz-zcode',
  updateUrl: 'https://cdn.jsdelivr.net/gh/zhouquanemail/gkd-custom@main/gkd_custom.json5',
  checkUpdateUrl: 'https://cdn.jsdelivr.net/gh/zhouquanemail/gkd-custom@main/gkd_custom.json5',
  supportUri: 'https://gkd.li/',
  categories: [],
  globalGroups: [
    {
      key: 0,
      name: '开屏广告-兜底',
      desc: '全 App：仅活动页命中 Splash/Welcome/Launch/AdSplash 的「跳过」才点击',
      fastQuery: true,
      matchTime: 10000,
      actionMaximum: 3,
      resetMatch: 'app',
      apps: [{ id: 'com.tinder', enable: false }],
      rules: [
        {
          key: 0,
          name: 'text跳过-开屏活动页',
          actionCdKey: 0,
          activityIds: { regex: '(?i)splash|welcome|launch|adsplash' },
          matches: ['[text*="跳过"][text.length<10][visibleToUser=true]'],
        },
        {
          key: 1,
          name: 'desc跳过-开屏活动页',
          actionCdKey: 0,
          activityIds: { regex: '(?i)splash|welcome|launch|adsplash' },
          matches: ['[desc*="跳过"][visibleToUser=true]'],
        },
      ],
    },
    {
      key: 20,
      name: 'Tinder 广告卡片-自动跳过',
      desc: 'AD 卡以全屏尺寸(width>1400)显现（=成为顶卡落定）时才点「跳过」(gamepad_pass)；池化池卡不命中',
      matchAnyApp: false,
      apps: [{ id: 'com.tinder' }],
      fastQuery: true,
      resetMatch: 'match',
      actionMaximum: 3,
      actionCd: 1500,
      rules: [
        {
          key: 0,
          name: '原生广告卡(全屏顶卡)',
          matchRoot: true,
          actionCdKey: 20,
          actionDelay: 200,
          matches: [
            '[vid="unified_static_image_rec_card_ad_view"][width>1400][visibleToUser=true]',
            '[vid="gamepad_pass"][visibleToUser=true]',
          ],
        },
      ],
    },
    {
      key: 30,
      name: 'Badoo Liftoff 全屏广告-关闭',
      desc: 'Liftoff(Vungle) MRAID endcard：识别 desc="Close button"（X 出现即发全局返回键，销毁 VungleActivity）',
      matchAnyApp: false,
      apps: [{ id: 'com.badoo.mobile' }],
      fastQuery: true,
      resetMatch: 'match',
      actionMaximum: 2,
      actionCd: 1000,
      rules: [
        {
          key: 0,
          name: 'Liftoff endcard back关闭',
          matchRoot: true,
          actionCdKey: 30,
          actionDelay: 300,
          action: 'back',
          matches: [
            '[desc="Close button"][clickable=true][visibleToUser=true]',
          ],
        },
      ],
    },
  ],
  apps: [],
}
