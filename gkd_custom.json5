// ZCode 局部补丁 v8（本机 + GitHub/jsDelivr CDN）
// 变更:
//  v8: 彻底禁用 Tinder 广告卡自动跳过组（group 20）—— a11y 节点树无法区分
//      "Deck 池中已预绑定的广告卡" 与 "顶部可交互广告卡"（两者都可见且 clickable），
//      规则会在牌堆打开即连续左滑真人卡。人工刷广告卡，兜底组保持不变
//      （Tinder 硬排除未动；开屏兜底正常工作）
{
  id: 10010001,
  name: 'ZCode 局部补丁',
  version: 8,
  author: 'zz-zcode',
  updateUrl: 'https://cdn.jsdelivr.net/gh/zhouquanemail/gkd-custom@main/gkd_custom.json5',
  checkUpdateUrl: 'https://cdn.jsdelivr.net/gh/zhouquanemail/gkd-custom@main/gkd_custom.json5',
  supportUri: 'https://gkd.li/',
  categories: [],
  globalGroups: [
    {
      key: 0,
      name: '开屏广告-兜底',
      desc: '全 App：仅活动页命中 Splash/Welcome/Launch/AdSplash 的「跳过」才点击',
      fastQuery: true,
      matchTime: 10000,
      actionMaximum: 3,
      resetMatch: 'app',
      apps: [{ id: 'com.tinder', enable: false }],
      rules: [
        {
          key: 0,
          name: 'text跳过-开屏活动页',
          actionCdKey: 0,
          activityIds: { regex: '(?i)splash|welcome|launch|adsplash' },
          matches: ['[text*="跳过"][text.length<10][visibleToUser=true]'],
        },
        {
          key: 1,
          name: 'desc跳过-开屏活动页',
          actionCdKey: 0,
          activityIds: { regex: '(?i)splash|welcome|launch|adsplash' },
          matches: ['[desc*="跳过"][visibleToUser=true]'],
        },
      ],
    },
    {
      key: 20,
      name: 'Tinder 广告卡片-自动跳过',
      desc: '已禁用(v8)：a11y 无法区分顶卡与池化预绑定广告卡，会误伤真人卡。如需自动跳过，需先抓取牌堆过渡期快照再设计判别条件',
      enable: false,
      matchAnyApp: false,
      apps: [{ id: 'com.tinder' }],
      fastQuery: true,
      matchTime: 10000,
      actionMaximum: 3,
      resetMatch: 'match',
      actionCd: 1500,
      rules: [
        {
          key: 0,
          name: '原生广告卡(unified_static_image)',
          matchRoot: true,
          actionCdKey: 20,
          actionDelay: 600,
          matches: [
            '[vid="unified_static_image_rec_card_ad_view"][clickable=true][visibleToUser=true]',
            '[vid="gamepad_pass"][visibleToUser=true]',
          ],
        },
        {
          key: 1,
          name: '原生广告卡(AD徽章)',
          matchRoot: true,
          actionCdKey: 20,
          actionDelay: 600,
          matches: [
            '[vid="ad_choices_container"][clickable=true][visibleToUser=true]',
            '[vid="gamepad_pass"][visibleToUser=true]',
          ],
        },
      ],
    },
  ],
  apps: [],
}
