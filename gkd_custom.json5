// ZCode 局部补丁 v7（本机 + GitHub/jsDelivr CDN）
// 变更:
//  v6: updateUrl 统一为全网可达的 jsDelivr CDN
//  v7: 广告卡规则加交互性门槛 clickable=true + actionDelay=600ms
//      修复：Deck 预实例化导致广告卡在底下时可见→提前命中→gamepad_pass 被
//      当前交互卡（上一张真人卡）消费→必定误伤前一张真人卡
//      只有 AD 卡成为顶卡（可交互）时才会触发左滑
{
  id: 10010001,
  name: 'ZCode 局部补丁',
  version: 7,
  author: 'zz-zcode',
  updateUrl: 'https://cdn.jsdelivr.net/gh/zhouquanemail/gkd-custom@main/gkd_custom.json5',
  checkUpdateUrl: 'https://cdn.jsdelivr.net/gh/zhouquanemail/gkd-custom@main/gkd_custom.json5',
  supportUri: 'https://gkd.li/',
  categories: [],
  globalGroups: [
    {
      key: 0,
      name: '开屏广告-兜底',
      desc: '全 App：仅活动页命中 Splash/Welcome/Launch/AdSplash 的「跳过」才点击',
      fastQuery: true,
      matchTime: 10000,
      actionMaximum: 3,
      resetMatch: 'app',
      apps: [{ id: 'com.tinder', enable: false }],
      rules: [
        {
          key: 0,
          name: 'text跳过-开屏活动页',
          actionCdKey: 0,
          activityIds: { regex: '(?i)splash|welcome|launch|adsplash' },
          matches: ['[text*="跳过"][text.length<10][visibleToUser=true]'],
        },
        {
          key: 1,
          name: 'desc跳过-开屏活动页',
          actionCdKey: 0,
          activityIds: { regex: '(?i)splash|welcome|launch|adsplash' },
          matches: ['[desc*="跳过"][visibleToUser=true]'],
        },
      ],
    },
    {
      key: 20,
      name: 'Tinder 广告卡片-自动跳过',
      desc: 'AD 徽章广告卡成为顶卡(clickable)时自动点「跳过」(gamepad_pass)；仅 com.tinder',
      matchAnyApp: false,
      apps: [{ id: 'com.tinder' }],
      fastQuery: true,
      resetMatch: 'match',
      actionMaximum: 8,
      actionCd: 1500,
      rules: [
        {
          key: 0,
          name: '原生广告卡(unified_static_image)',
          matchRoot: true,
          actionCdKey: 20,
          actionDelay: 600,
          matches: [
            '[vid="unified_static_image_rec_card_ad_view"][clickable=true][visibleToUser=true]',
            '[vid="gamepad_pass"][visibleToUser=true]',
          ],
        },
        {
          key: 1,
          name: '原生广告卡(AD徽章)',
          matchRoot: true,
          actionCdKey: 20,
          actionDelay: 600,
          matches: [
            '[vid="ad_choices_container"][clickable=true][visibleToUser=true]',
            '[vid="gamepad_pass"][visibleToUser=true]',
          ],
        },
      ],
    },
  ],
  apps: [],
}
